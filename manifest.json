{
  "manifest_version": 3,
  "name": "BetterCSU-Portal",
  "version": "1.0.5",
  "description": "讓正修訊息網更好用：週課表、功能釘選與歷年學分篩選。",
  "content_scripts": [
    {
      "matches": [
        "https://portal.csu.edu.tw/*"
      ],
      "js": [
        "features.js",
        "pins.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.csu.edu.tw/min_stuTimeTable.aspx*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.csu.edu.tw/min_stuCreditList.aspx*"
      ],
      "js": [
        "features.js",
        "credits.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}
