{
  "manifest_version": 3,
  "name": "BetterCSU-Portal",
  "version": "1.1.1",
  "description": "讓正修訊息網更好用：週課表、功能釘選與歷年學分篩選。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.csu.edu.tw/*"
      ],
      "js": [
        "features.js",
        "pins.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.csu.edu.tw/min_stuTimeTable.aspx*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.csu.edu.tw/min_stuCreditList.aspx*"
      ],
      "js": [
        "features.js",
        "credits.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}
